    {
      "name": "Button",
      "kind": "button",
      "refersTo": "button",
      "description": "Default grey control.",
      "html": "<button class=\"ds-btn\">Cancel</button>",
      "css": ".ds-btn{font:13px system-ui,sans-serif;padding:3px 12px;border-radius:6px;border:1px solid rgb(31 35 40 / 15%);background:#f6f8fa;color:#1f2328}.ds-btn:hover{background:#f3f4f6}.ds-btn:focus-visible{outline:2px solid #1f883d}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one main action in a dialog.",
      "html": "<button class=\"ds-btn-primary\">Save</button>",
      "css": ".ds-btn-primary{font:13px system-ui,sans-serif;padding:3px 12px;border-radius:6px;border:1px solid rgb(31 35 40 / 15%);border-color:transparent;background:#1f883d;color:#fff}.ds-btn-primary:hover{filter:brightness(1.1)}.ds-btn-primary:focus-visible{outline:2px solid #1f883d;outline-offset:2px}"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Destructive confirmation.",
      "html": "<button class=\"ds-btn-danger\">Delete</button>",
      "css": ".ds-btn-danger{font:13px system-ui,sans-serif;padding:3px 12px;border-radius:6px;border:1px solid rgb(31 35 40 / 15%);border-color:transparent;background:#d1242f;color:#fff}.ds-btn-danger:focus-visible{outline:2px solid #d1242f;outline-offset:2px}"
    },
    {
      "name": "Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Text field.",
      "html": "<input class=\"ds-input\" placeholder=\"Host name\">",
      "css": ".ds-input{font:13px system-ui,sans-serif;padding:3px 6px;border:1px solid #d0d7de;border-radius:6px;background:#fff;color:#1f2328}.ds-input::placeholder{color:#818b98}.ds-input:focus-visible{outline:2px solid #1f883d}"
    },
    {
      "name": "Session Tree Row",
      "kind": "nav",
      "refersTo": "tree-row",
      "description": "22px row with a type mark; teal for SSH, amber for Local shell.",
      "html": "<div class=\"ds-tree\"><div class=\"ds-row\"><span class=\"ds-edge\"></span><span class=\"ds-name\">prod-db-01</span><span class=\"ds-detail\">ssh</span></div><div class=\"ds-row ds-cur\"><span class=\"ds-edge ds-local\"></span><span class=\"ds-name\">pwsh</span><span class=\"ds-detail\">local</span></div></div>",
      "css": ".ds-tree{width:240px;background:#f6f8fa;font:13px system-ui,sans-serif;color:#1f2328}.ds-row{display:flex;align-items:center;gap:6px;height:22px;padding:0 8px}.ds-row:hover{background:rgb(208 215 222 / 32%)}.ds-cur{background:rgb(208 215 222 / 48%)}.ds-edge{width:3px;height:14px;border-radius:2px;background:#1b7c83}.ds-local{background:#9a6700}.ds-name{flex:1}.ds-detail{color:#656d76}"
    },
    {
      "name": "Menu",
      "kind": "card",
      "refersTo": "menu",
      "description": "Floating menu with keyboard hints.",
      "html": "<div class=\"ds-menu\"><div>Open<span>Enter</span></div><div>Rename<span>F2</span></div><hr><div class=\"ds-d\">Delete</div></div>",
      "css": ".ds-menu{min-width:160px;padding:4px 0;background:#fff;border:1px solid #d0d7de;border-radius:6px;box-shadow:0 8px 24px rgb(140 149 159 / 20%);font:13px system-ui,sans-serif;color:#1f2328}.ds-menu div{display:flex;gap:16px;height:22px;padding:0 12px;align-items:center}.ds-menu div:hover{background:rgb(208 215 222 / 32%)}.ds-menu span{margin-left:auto;color:#818b98}.ds-menu hr{margin:4px 0;border:0;border-top:1px solid #d0d7de}.ds-d{color:#d1242f}"
    },
