{
  "name": "slop-term",
  "productName": "slop-term",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SSH, SFTP and local shell client",
  "license": "MIT",
  "author": {
    "name": "niktekusho",
    "email": "niktekusho@users.noreply.github.com"
  },
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "start:profile": "electron-forge start --inspect-electron",
    "package": "electron-forge package",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "packageManager": "pnpm@10.28.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-pty",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.9.3",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.89.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.2.8",
    "@napi-rs/keyring": "2.1.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.2.0-beta.15",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ssh-config": "5.3.0",
    "ssh2": "1.17.0"
  }
}
